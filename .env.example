# Copy to .env and fill in the values. NEVER commit .env — Scripts/generate-secrets.sh turns it
# into the gitignored AppBox/Generated/AppBoxSecrets.swift at build time.

# Static client token for the AppBox backend (install-helper) — must match the server's
# APPBOX_CLIENT_TOKEN environment variable.
APPBOX_CLIENT_TOKEN=

# The Dropbox OAuth client_id (public app key). Must match the app's `db-<key>` URL scheme in
# AppBox/Info.plist. From the Dropbox App Console.
DROPBOX_APP_KEY=
